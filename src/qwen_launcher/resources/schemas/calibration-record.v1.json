{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen-launcher.dev/schemas/calibration-record.v1.json",
  "title": "qwen-launcher calibration-record/v1",
  "description": "Private local record produced by calibration/v2 and reused only on the machine and contracts that measured it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "created_at",
    "launcher_version",
    "calibration_protocol",
    "benchmark_protocol",
    "model",
    "model_sha256",
    "engine_release",
    "engine_source_commit",
    "command_contract_sha256",
    "os_name",
    "backend",
    "hardware",
    "envelope",
    "observed",
    "benchmark",
    "search",
    "selection_rule"
  ],
  "properties": {
    "schema": {
      "description": "Versioned schema identifier for this local record.",
      "const": "calibration-record/v1"
    },
    "mode": {
      "description": "Packaged mode this record calibrates, equal to the file name without extension.",
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "created_at": {
      "description": "UTC date and time when the record was generated.",
      "type": "string",
      "format": "date-time"
    },
    "launcher_version": {
      "description": "Exact qwen-launcher version that generated the record.",
      "type": "string",
      "minLength": 1
    },
    "calibration_protocol": {
      "description": "Versioned search algorithm that produced this record.",
      "const": "calibration/v2"
    },
    "benchmark_protocol": {
      "description": "Benchmark protocol used to confirm every finalist.",
      "const": "benchmark/v1"
    },
    "model": {
      "description": "Complete calibrated model identifier.",
      "type": "string",
      "minLength": 1
    },
    "model_sha256": {
      "description": "SHA-256 of the pinned model artifact the record was measured against.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "engine_release": {
      "description": "Exact llama.cpp release used for calibration.",
      "type": "string",
      "minLength": 1
    },
    "engine_source_commit": {
      "description": "Full source commit of the calibrated llama.cpp release.",
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "command_contract_sha256": {
      "description": "SHA-256 of the canonical engine.lock command contract used for calibration.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "os_name": {
      "description": "Operating system the record was measured on.",
      "enum": ["linux", "windows"]
    },
    "backend": {
      "description": "Backend the record was measured on.",
      "enum": ["cuda", "cpu"]
    },
    "hardware": {
      "description": "Stable hardware identity that must match exactly for reuse.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_name",
        "cpu_cores",
        "ram_total_gib",
        "gpu_count",
        "gpu_name",
        "gpu_driver",
        "vram_total_gib"
      ],
      "properties": {
        "cpu_name": {
          "description": "Detected CPU model name.",
          "type": "string",
          "minLength": 1
        },
        "cpu_cores": {
          "description": "Detected logical CPU core count.",
          "type": "integer",
          "minimum": 1
        },
        "ram_total_gib": {
          "description": "Detected total RAM in exact GiB.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gpu_count": {
          "description": "Detected NVIDIA GPU count.",
          "type": "integer",
          "minimum": 0
        },
        "gpu_name": {
          "description": "Selected GPU name, or null on CPU.",
          "type": ["string", "null"],
          "minLength": 1
        },
        "gpu_driver": {
          "description": "Measured GPU driver version, or null on CPU.",
          "type": ["string", "null"],
          "minLength": 1
        },
        "vram_total_gib": {
          "description": "Selected GPU total VRAM in exact GiB, or null on CPU.",
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        }
      }
    },
    "envelope": {
      "description": "Locally selected launch envelope for this mode.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ctx", "n_cpu_moe"],
      "properties": {
        "ctx": {
          "description": "Selected context from the approved calibration/v2 scale.",
          "enum": [131072, 65536, 32768, 16384, 8192]
        },
        "n_cpu_moe": {
          "description": "Selected CPU MoE block count, or null on CPU.",
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "observed": {
      "description": "Measured resource needs and minima used by the launch headroom check.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ram_needed_gib",
        "minimum_ram_available_gib",
        "vram_needed_gib",
        "minimum_vram_free_gib"
      ],
      "properties": {
        "ram_needed_gib": {
          "description": "Maximum measured RAM range across stable starts in GiB.",
          "type": "number",
          "minimum": 0
        },
        "minimum_ram_available_gib": {
          "description": "Minimum available RAM observed across stable starts in GiB.",
          "type": "number",
          "minimum": 0
        },
        "vram_needed_gib": {
          "description": "Maximum measured incremental VRAM need in GiB, or null on CPU.",
          "type": ["number", "null"],
          "minimum": 0
        },
        "minimum_vram_free_gib": {
          "description": "Minimum free VRAM observed across stable starts in GiB, or null on CPU.",
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "benchmark": {
      "description": "benchmark/v1 evidence of the selected finalist.",
      "type": "object",
      "additionalProperties": false,
      "required": ["warmup_tok_s", "measured_tok_s", "tok_s"],
      "properties": {
        "warmup_tok_s": {
          "description": "Excluded benchmark warm-up token rate.",
          "type": "number",
          "minimum": 0
        },
        "measured_tok_s": {
          "description": "Five included benchmark/v1 token rates.",
          "$ref": "#/$defs/five_measures"
        },
        "tok_s": {
          "description": "Minimum, median, and maximum of the included rates.",
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "median", "max"],
          "properties": {
            "min": {
              "description": "Minimum included token rate.",
              "type": "number",
              "minimum": 0
            },
            "median": {
              "description": "Median included token rate.",
              "type": "number",
              "minimum": 0
            },
            "max": {
              "description": "Maximum included token rate.",
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "search": {
      "description": "Versioned algorithm constants and exact measured search evidence.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_scale",
        "probe_cap",
        "vram_reserve_gib",
        "release_tolerance_gib",
        "stable_start_runs",
        "did_degrade",
        "probes",
        "finalists"
      ],
      "properties": {
        "context_scale": {
          "description": "Approved descending calibration/v2 context scale.",
          "const": [131072, 65536, 32768, 16384, 8192]
        },
        "probe_cap": {
          "description": "Maximum screening probes per mode.",
          "const": 12
        },
        "vram_reserve_gib": {
          "description": "Required minimum free VRAM during CUDA trials in GiB.",
          "const": 0.5
        },
        "release_tolerance_gib": {
          "description": "Allowed VRAM release and baseline drift tolerance in GiB.",
          "const": 0.125
        },
        "stable_start_runs": {
          "description": "Fresh stable starts required for every finalist.",
          "const": 2
        },
        "did_degrade": {
          "description": "Whether measured peak evidence forced linear screening.",
          "type": "boolean"
        },
        "probes": {
          "description": "Screening probes in exact execution order.",
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/probe" }
        },
        "finalists": {
          "description": "One or two finalists in deterministic confirmation order.",
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/finalist" }
        }
      }
    },
    "selection_rule": {
      "description": "Deterministic rule that produced the recorded envelope.",
      "enum": [
        "dominance-median-over-maximum",
        "equivalent-prefer-minimum-free-vram",
        "equivalent-prefer-prudent",
        "single-finalist",
        "cpu-baseline-confirmation"
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "backend": { "const": "cpu" } } },
      "then": {
        "properties": {
          "envelope": { "properties": { "n_cpu_moe": { "type": "null" } } },
          "hardware": {
            "properties": {
              "gpu_count": { "const": 0 },
              "gpu_name": { "type": "null" },
              "gpu_driver": { "type": "null" },
              "vram_total_gib": { "type": "null" }
            }
          },
          "observed": {
            "properties": {
              "vram_needed_gib": { "type": "null" },
              "minimum_vram_free_gib": { "type": "null" }
            }
          },
          "search": {
            "properties": {
              "probes": { "maxItems": 0 },
              "finalists": {
                "maxItems": 1,
                "items": {
                  "properties": {
                    "n_cpu_moe": { "type": "null" },
                    "vram_needed_gib": { "type": "null" },
                    "minimum_free_vram_gib": { "type": "null" }
                  }
                }
              }
            }
          },
          "selection_rule": { "const": "cpu-baseline-confirmation" }
        }
      },
      "else": {
        "properties": {
          "envelope": { "properties": { "n_cpu_moe": { "type": "integer" } } },
          "hardware": {
            "properties": {
              "gpu_count": { "type": "integer", "minimum": 1 },
              "gpu_name": { "type": "string" },
              "gpu_driver": { "type": "string" },
              "vram_total_gib": { "type": "number" }
            }
          },
          "observed": {
            "properties": {
              "vram_needed_gib": { "type": "number" },
              "minimum_vram_free_gib": { "type": "number" }
            }
          },
          "search": {
            "properties": {
              "finalists": {
                "items": { "properties": { "n_cpu_moe": { "type": "integer" } } }
              }
            }
          },
          "selection_rule": {
            "enum": [
              "dominance-median-over-maximum",
              "equivalent-prefer-minimum-free-vram",
              "equivalent-prefer-prudent",
              "single-finalist"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "five_measures": {
      "description": "Exactly five valid benchmark/v1 measurements.",
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "type": "number", "minimum": 0 }
    },
    "probe": {
      "description": "One fixed-context screening probe and its measured peak.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ctx", "n_cpu_moe", "is_feasible", "reason", "peak_used_gib"],
      "properties": {
        "ctx": {
          "description": "Context used by this screening probe.",
          "enum": [131072, 65536, 32768, 16384, 8192]
        },
        "n_cpu_moe": {
          "description": "CPU MoE block count used by this screening probe.",
          "type": "integer",
          "minimum": 0
        },
        "is_feasible": {
          "description": "Whether the mode workload and reserve checks completed.",
          "type": "boolean"
        },
        "reason": {
          "description": "Discard reason, or null for a feasible probe.",
          "type": ["string", "null"],
          "minLength": 1
        },
        "peak_used_gib": {
          "description": "Aggregate peak used VRAM when measurable, otherwise null.",
          "type": ["number", "null"],
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": { "properties": { "is_feasible": { "const": true } } },
          "then": {
            "properties": {
              "reason": { "type": "null" },
              "peak_used_gib": { "type": "number" }
            }
          },
          "else": { "properties": { "reason": { "type": "string" } } }
        }
      ]
    },
    "finalist": {
      "description": "One confirmed finalist with selection and resource evidence.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ctx",
        "n_cpu_moe",
        "outcome",
        "discard_reason",
        "measured_tok_s",
        "ram_needed_gib",
        "minimum_ram_available_gib",
        "vram_needed_gib",
        "minimum_free_vram_gib",
        "is_selected"
      ],
      "properties": {
        "ctx": {
          "description": "Context shared by every finalist in the mode.",
          "enum": [131072, 65536, 32768, 16384, 8192]
        },
        "n_cpu_moe": {
          "description": "Finalist CPU MoE block count, or null on CPU.",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "outcome": {
          "description": "Whether all confirmation requirements passed.",
          "enum": ["valid", "discarded"]
        },
        "discard_reason": {
          "description": "Confirmation discard reason, or null for a valid finalist.",
          "type": ["string", "null"],
          "minLength": 1
        },
        "measured_tok_s": {
          "description": "Five benchmark rates for a valid finalist, otherwise null.",
          "anyOf": [{ "$ref": "#/$defs/five_measures" }, { "type": "null" }]
        },
        "ram_needed_gib": {
          "description": "Measured RAM range in GiB when available.",
          "type": ["number", "null"],
          "minimum": 0
        },
        "minimum_ram_available_gib": {
          "description": "Minimum available RAM observed in GiB when available.",
          "type": ["number", "null"],
          "minimum": 0
        },
        "vram_needed_gib": {
          "description": "Measured incremental VRAM need in GiB when available.",
          "type": ["number", "null"],
          "minimum": 0
        },
        "minimum_free_vram_gib": {
          "description": "Minimum free VRAM observed in GiB when available.",
          "type": ["number", "null"],
          "minimum": 0
        },
        "is_selected": {
          "description": "Whether this valid finalist produced the launch envelope.",
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "valid" } } },
          "then": {
            "properties": {
              "discard_reason": { "type": "null" },
              "measured_tok_s": { "$ref": "#/$defs/five_measures" },
              "ram_needed_gib": { "type": "number" },
              "minimum_ram_available_gib": { "type": "number" }
            }
          },
          "else": {
            "properties": {
              "discard_reason": { "type": "string" },
              "measured_tok_s": { "type": "null" },
              "is_selected": { "const": false }
            }
          }
        }
      ]
    }
  }
}
