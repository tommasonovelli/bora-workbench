{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwen-launcher.dev/schemas/calibration-report.v2.json",
  "title": "qwen-launcher calibration-report/v2",
  "description": "Privacy-reviewed calibration/v3 reference evidence whose local envelope is usable only as probe ordering.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "created_at",
    "decision",
    "privacy_reviewed",
    "policy_id",
    "calibration_protocol",
    "benchmark_protocol",
    "model",
    "model_sha256",
    "engine_release",
    "engine_source_commit",
    "command_contract_sha256",
    "hardware",
    "gate",
    "search",
    "modes",
    "seed_usage",
    "performance_portability",
    "source_references"
  ],
  "properties": {
    "schema": {
      "description": "Versioned schema identifier for shared calibration/v3 evidence.",
      "const": "calibration-report/v2"
    },
    "id": {
      "description": "Stable report identifier equal to the file name without its extension.",
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "created_at": {
      "description": "UTC timestamp of the reviewed reference report.",
      "type": "string",
      "format": "date-time"
    },
    "decision": {
      "description": "The evidence is accepted as a local reference, not as a portable envelope.",
      "const": "accepted-reference"
    },
    "privacy_reviewed": {
      "description": "Human confirmation that no hostname, username, or private path is shared.",
      "const": true
    },
    "policy_id": {
      "description": "Public calibration/v3 policy governing interpretation of this evidence.",
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "calibration_protocol": {
      "description": "Local protocol that produced this evidence.",
      "const": "calibration/v3"
    },
    "benchmark_protocol": {
      "description": "Unchanged benchmark used in each confirmation session.",
      "const": "benchmark/v1"
    },
    "model": {
      "description": "Complete measured model identifier.",
      "type": "string",
      "minLength": 1
    },
    "model_sha256": {
      "description": "SHA-256 of the exact measured model artifact.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "engine_release": {
      "description": "Exact measured llama.cpp release.",
      "type": "string",
      "minLength": 1
    },
    "engine_source_commit": {
      "description": "Full source commit of the measured engine release.",
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "command_contract_sha256": {
      "description": "SHA-256 of the canonical measured command contract.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hardware": {
      "description": "Privacy-safe facts for the only material calibration/v3 evidence currently available.",
      "$ref": "#/$defs/hardware"
    },
    "gate": {
      "description": "Local acceptance and explicitly partial cross-hardware coverage.",
      "$ref": "#/$defs/gate"
    },
    "search": {
      "description": "Exact calibration/v3 method snapshot exercised by this report.",
      "$ref": "#/$defs/search"
    },
    "modes": {
      "description": "Local observations keyed by existing mode. Envelopes remain evidence, never launch plans.",
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z0-9-]+$": { "$ref": "#/$defs/mode_evidence" }
      },
      "additionalProperties": false
    },
    "seed_usage": {
      "description": "The runtime may read only seed_n_cpu_moe to reorder an otherwise unchanged search.",
      "const": "probe-ordering-only-complete-local-search"
    },
    "performance_portability": {
      "description": "Observed rates and envelopes are not promises for other components.",
      "const": "observed-values-are-not-promises"
    },
    "source_references": {
      "description": "Repository-relative, immutable provenance references.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source_reference" }
    }
  },
  "$defs": {
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os_name",
        "os_version",
        "backend",
        "ram_total_gib",
        "gpu_name",
        "gpu_driver",
        "vram_total_gib"
      ],
      "properties": {
        "os_name": {
          "description": "Normalized measured operating system.",
          "enum": ["linux", "windows"]
        },
        "os_version": {
          "description": "Privacy-safe measured operating-system version.",
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "description": "Backend used by the measured run.",
          "enum": ["cuda", "cpu"]
        },
        "ram_total_gib": {
          "description": "Measured total system RAM in exact GiB.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gpu_name": {
          "description": "Measured GPU model, or null on CPU.",
          "type": ["string", "null"],
          "minLength": 1
        },
        "gpu_driver": {
          "description": "Measured GPU driver, or null on CPU.",
          "type": ["string", "null"],
          "minLength": 1
        },
        "vram_total_gib": {
          "description": "Measured total GPU VRAM, or null on CPU.",
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_result",
        "overall_status",
        "constants_validated_on_materially_different_hardware",
        "heterogeneous_hardware_follow_up"
      ],
      "properties": {
        "local_result": {
          "description": "Decision for this exact OS, backend, hardware, and modes.",
          "const": "calibration-accepted"
        },
        "overall_status": {
          "description": "Cross-hardware empirical coverage remains partial.",
          "const": "gate-partial"
        },
        "constants_validated_on_materially_different_hardware": {
          "description": "No materially different hardware has yet exercised these constants.",
          "const": false
        },
        "heterogeneous_hardware_follow_up": {
          "description": "The heterogeneous run remains open without blocking Step 5B.",
          "const": "open-non-blocking"
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_scale",
        "n_cpu_moe_domain",
        "probe_cap",
        "vram_reserve_gib",
        "ram_reserve_gib",
        "release_tolerance_gib",
        "confirm_rounds",
        "confirmation_order",
        "selection_rule"
      ],
      "properties": {
        "context_scale": {
          "description": "Descending context scale exercised by the protocol.",
          "const": [131072, 65536, 32768, 16384, 8192]
        },
        "n_cpu_moe_domain": {
          "description": "Complete CUDA axis derived from pinned-model metadata.",
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum", "maximum_source"],
          "properties": {
            "minimum": {
              "description": "Inclusive legal lower bound.",
              "const": 0
            },
            "maximum": {
              "description": "Inclusive block count read from the pinned GGUF.",
              "type": "integer",
              "minimum": 1
            },
            "maximum_source": {
              "description": "Model metadata, not report hardware, supplies the upper bound.",
              "const": "gguf-block-count"
            }
          }
        },
        "probe_cap": {
          "description": "Maximum screening processes per mode.",
          "const": 12
        },
        "vram_reserve_gib": {
          "description": "Minimum aggregate free VRAM throughout CUDA trials.",
          "const": 0.5
        },
        "ram_reserve_gib": {
          "description": "Minimum available RAM throughout every trial.",
          "const": 2.0
        },
        "release_tolerance_gib": {
          "description": "Post-stop release and baseline-drift interpretation threshold.",
          "const": 0.125
        },
        "confirm_rounds": {
          "description": "Number of paired confirmation rounds.",
          "const": 2
        },
        "confirmation_order": {
          "description": "Deterministic A-B/B-A temporal order.",
          "const": ["a", "b", "b", "a"]
        },
        "selection_rule": {
          "description": "Unanimous paired throughput, then margin, then prudence.",
          "const": "paired-round-unanimity-then-memory-margin-then-prudence"
        }
      }
    },
    "envelope": {
      "description": "Locally observed result retained only as evidence.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ctx", "n_cpu_moe"],
      "properties": {
        "ctx": {
          "description": "Context selected on the evidence host.",
          "enum": [131072, 65536, 32768, 16384, 8192]
        },
        "n_cpu_moe": {
          "description": "CPU MoE block count selected only on the evidence host.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n_cpu_moe", "is_feasible"],
      "properties": {
        "n_cpu_moe": {
          "description": "Locally measured screening point.",
          "type": "integer",
          "minimum": 0
        },
        "is_feasible": {
          "description": "Whether the local trial completed while respecting reserves.",
          "type": "boolean"
        }
      }
    },
    "nullable_rate": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "finalist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n_cpu_moe", "outcome", "round_medians_tok_s"],
      "properties": {
        "n_cpu_moe": {
          "description": "Locally confirmed finalist axis value.",
          "type": "integer",
          "minimum": 0
        },
        "outcome": {
          "description": "Whether both local confirmation sessions respected the protocol.",
          "enum": ["valid", "discarded"]
        },
        "round_medians_tok_s": {
          "description": "Two published session medians, or null where the reviewed summary omitted them.",
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/nullable_rate" }
        }
      }
    },
    "mode_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_local_envelope",
        "seed_n_cpu_moe",
        "probe_sequence",
        "finalists",
        "selection_rule",
        "minimum_ram_available_gib",
        "minimum_vram_free_gib",
        "maximum_release_above_baseline_gib",
        "baseline_drift_gib"
      ],
      "properties": {
        "observed_local_envelope": {
          "description": "Evidence-host result that is never copied into a remote launch plan.",
          "$ref": "#/$defs/envelope"
        },
        "seed_n_cpu_moe": {
          "description": "Only field exposed to runtime seed ordering; it is never a final envelope.",
          "type": "integer",
          "minimum": 0
        },
        "probe_sequence": {
          "description": "Exact local screening order and feasibility outcomes.",
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/probe" }
        },
        "finalists": {
          "description": "One or two locally confirmed boundary candidates.",
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/finalist" }
        },
        "selection_rule": {
          "description": "Reconstructed local selection outcome.",
          "enum": [
            "dominance-unanimous-rounds",
            "equivalent-prefer-minimum-free-vram",
            "equivalent-prefer-prudent",
            "equivalent-after-baseline-drift",
            "single-finalist"
          ]
        },
        "minimum_ram_available_gib": {
          "description": "Minimum available RAM across accepted local evidence.",
          "type": "number",
          "minimum": 0
        },
        "minimum_vram_free_gib": {
          "description": "Minimum free VRAM across accepted local evidence.",
          "type": "number",
          "minimum": 0
        },
        "maximum_release_above_baseline_gib": {
          "description": "Largest accepted post-stop used-VRAM excess.",
          "type": "number",
          "minimum": 0
        },
        "baseline_drift_gib": {
          "description": "Aggregate confirmation baseline excursion.",
          "type": "number",
          "minimum": 0
        }
      }
    },
    "relative_repo_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "description": "Repository-relative source evidence path.",
          "$ref": "#/$defs/relative_repo_path"
        },
        "sha256": {
          "description": "SHA-256 of exact referenced source bytes.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
