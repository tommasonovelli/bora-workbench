# Preserve measured engine output byte-for-byte and keep raw files out of textual diffs.
/evidence/engine/spike-0/** -text -diff
/evidence/engine/kv-q8-ubuntu/** -text -diff
/evidence/engine/kv-q8-windows/** -text -diff
# Preserve benchmark/calibration protocol resources byte-for-byte on Windows checkouts.
/src/qwen_launcher/resources/benchmark-v1/** -text
/src/qwen_launcher/resources/benchmark-quick/** -text
/src/qwen_launcher/resources/calibration-v1/** -text
# Preserve accepted calibration sources, manifests, and packaged links for reproducible digests.
/evidence/calibration/windows-11-rtx-2060-super-v3/** -text
/src/qwen_launcher/resources/content/calibration-policy.json -text
/src/qwen_launcher/resources/content/calibrations/** -text
# Preserve the exact NVIDIA notice bytes verified by the Spike 0 digest.
/src/qwen_launcher/resources/notices/NVIDIA-CUDA-EULA.html -text -diff
# The normative plan uses Markdown hard line breaks intentionally.
/IMPLEMENTATION_SPEC.md whitespace=-blank-at-eol
# Pin installer line endings so the POSIX and PowerShell scripts run on every checkout.
/install.sh text eol=lf
/install.ps1 text eol=crlf
